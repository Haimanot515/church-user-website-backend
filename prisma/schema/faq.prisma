model Faq {
  id         String      @id @default(uuid())
  question   String
  answer     String
  category   FaqCategory
  order      Int         @default(0)
  languageId String
  language   Language    @relation(fields: [languageId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

enum FaqCategory {
  Information
  Faith
  Contact
}
