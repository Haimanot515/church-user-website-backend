model Message {
  id          String   @id @default(uuid())
  threadId    String
  thread      Thread   @relation(fields: [threadId], references: [id])
  message     String
  fromAdmin   Boolean
  readByAdmin Boolean  @default(false)
  clientId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([threadId])
  @@index([clientId])
  @@index([threadId, createdAt])
}
