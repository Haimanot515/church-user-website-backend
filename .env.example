# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=5000

# Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Access token lifetime, default 15m (examples: 30m, 1h). Clients renew it with POST /api/auth/refresh.
JWT_EXPIRES_IN=15m
# Refresh token and session idle lifetime, default 7d
REFRESH_EXPIRES_IN=7d
# A session can never be renewed past this many days after login, default 30
SESSION_MAX_AGE_DAYS=30

# REQUIRED in production: set CLIENT_URL and/or CORS_ORIGINS to https origins with no trailing slash.
# Browser origins allowed by CORS (comma separated). localhost is allowed automatically outside production.
CLIENT_URL=https://your-frontend.example.com
CORS_ORIGINS=https://your-admin.example.com

# Public URL of THIS backend (used to build unsubscribe links), no trailing slash
BACKEND_URL=https://your-backend.example.com

# Email (Brevo HTTP API)
BREVO_API_KEY=
EMAIL_FROM=you@yourdomain.com
EMAIL_FROM_NAME=Your Church Name

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Security tuning (all optional; defaults shown). Validated at startup.
BCRYPT_SALT_ROUNDS=10            # 4-15, at least 10 in production
MAX_LOGIN_ATTEMPTS=5             # wrong passwords before the account is locked
LOCKOUT_DURATION_MINUTES=15
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
THROTTLE_WINDOW_MINUTES=15       # global rate-limit window
THROTTLE_LIMIT=600               # requests per window per IP under /api
AUTH_RATE_LIMIT=20               # login/register/verify per IP per 15 min
LOGIN_RATE_LIMIT=8               # login attempts per IP+email per 15 min

# Number of reverse proxies in front of this app (Render = 1, direct = 0). Wrong values break rate limiting by IP.
TRUST_PROXY_HOPS=1

# Minimum length for newly chosen passwords (no composition rules, common passwords are rejected)
PASSWORD_MIN_LENGTH=8

# Wrong re-authentication passwords allowed per admin per 15 min (delete user, change admin or role)
MAX_REAUTH_ATTEMPTS=5

# Cloudflare Turnstile captcha on register, login and verify. Clients send the token in the X-Captcha-Token header.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# Upload size limits in MB (optional)
MAX_IMAGE_UPLOAD_MB=10
MAX_MEDIA_UPLOAD_MB=50

# Seed script only (never needed in production)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=
